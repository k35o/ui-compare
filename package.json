{
  "name": "ui-compare",
  "version": "0.0.0",
  "description": "Capture pages and Storybook stories before and after a UI change, and compare them in one HTML report.",
  "keywords": [
    "ai-agent",
    "before-after",
    "playwright",
    "screenshot",
    "storybook",
    "visual-regression"
  ],
  "homepage": "https://github.com/k35o/ui-compare#readme",
  "bugs": "https://github.com/k35o/ui-compare/issues",
  "license": "MIT",
  "author": "k8o (https://github.com/k35o)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/ui-compare.git"
  },
  "bin": {
    "ui-compare": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "check:write": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "skill:validate": "skills-ref validate plugin/skills/ui-compare"
  },
  "dependencies": {
    "cac": "7.1.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@k8o/oxc-config": "1.1.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "skills-ref": "0.1.5",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}
